<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The host's input journal for the tests, without Unity. It compiles the Unity project's own
    InputProgram.cs, so the tests exercise the code a player runs.
    Build with -p:SkunkworksSource=<the Skunkworks checkout>.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequireSkunkworks" BeforeTargets="CoreCompile">
    <Error Condition="'$(SkunkworksSource)' == '' Or !Exists('$(SkunkworksSource)/Unity/Assets/Scripts/InputProgram.cs')"
           Text="Set SkunkworksSource to a Skunkworks checkout." />
  </Target>
  <ItemGroup>
    <Compile Include="$(SkunkworksSource)/Unity/Assets/Scripts/InputProgram.cs" Link="Skunkworks/InputProgram.cs" />
    <Compile Include="Host.cs" />
  </ItemGroup>
</Project>
